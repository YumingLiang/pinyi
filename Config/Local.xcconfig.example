// 复制为 Config/Local.xcconfig（不入库），填自己的值。
// Team ID：Xcode → Settings → Accounts → 选中 Apple ID → 个人 Team（Personal Team）旁的 ID；
// 或先在 Xcode 的 Signing & Capabilities 里选一次 Team，再从 build settings 的 DEVELOPMENT_TEAM 抄过来。
DEVELOPMENT_TEAM = XXXXXXXXXX

// 免费 Team 的 Bundle ID 必须全球唯一，建议带上自己的前缀和 .dev
PINYI_BUNDLE_ID = com.yumingliang.pinyi.dev
